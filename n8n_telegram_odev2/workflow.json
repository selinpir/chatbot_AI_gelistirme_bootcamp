    {
      "parameters": {
        "jsCode": "\nconst raw = $('AI Agent').first().json.output;\nconst message = $('Telegram Trigger').first().json.message;\nconst products = $input.all().map(item => item.json);\n\nlet intent;\n\ntry {\n  const cleaned = typeof raw === 'string'\n    ? raw.trim()\n        .replace(/^```(?:json)?\\s*/i, '')\n        .replace(/\\s*```$/, '')\n    : raw;\n\n  intent = typeof cleaned === 'string'\n    ? JSON.parse(cleaned)\n    : cleaned;\n} catch {\n  return [{ json: {\n    status: 'error',\n    reply: 'Mesaj yorumlanamadı. Tekrar dener misin?'\n  }}];\n}\n\nconst result = {\n  operation: intent.operation,\n  sku: intent.sku,\n  quantity: intent.quantity,\n  source_text: message.text,\n  chat_id: message.chat.id\n};\n\nif (intent.needs_clarification || intent.operation === 'clarify') {\n  return [{ json: {\n    ...result,\n    status: 'clarify',\n    reply: intent.question || 'Hangi ürünü kastediyorsun?'\n  }}];\n}\n\nconst product = products.find(p => p.sku === intent.sku);\n\nif (!product) {\n  return [{ json: {\n    ...result,\n    status: 'not_found',\n    reply: 'Ürün bulunamadı.'\n  }}];\n}\n\nconst before = Number(product.stock);\n\nif (!Number.isInteger(before) || before < 0) {\n  throw new Error('Google Sheets stok değeri geçersiz.');\n}\n\nif (intent.operation === 'query') {\n  return [{ json: {\n    ...result,\n    product_name: product.product_name,\n    before,\n    status: 'query',\n    reply: `${product.product_name} stoğu: ${before} adet.`\n  }}];\n}\n\nconst op = intent.operation;\nconst qty = Number(intent.quantity);\n\nif (!['sell', 'add', 'set'].includes(op) ||\n    intent.quantity === null ||\n    !Number.isInteger(qty) ||\n    (op === 'set' ? qty < 0 : qty <= 0)) {\n  return [{ json: {\n    ...result,\n    status: 'invalid',\n    reply: 'Geçerli bir işlem ve miktar belirtmelisin.'\n  }}];\n}\n\nconst after = op === 'sell' ? before - qty\n            : op === 'add' ? before + qty\n            : qty;\n\nif (after < 0) {\n  return [{ json: {\n    ...result,\n    before,\n    status: 'rejected',\n    reply: `Yetersiz stok. Mevcut: ${before} adet.`\n  }}];\n}\n\nreturn [{ json: {\n  ...result,\n  product_name: product.product_name,\n  quantity: qty,\n  before,\n  after,\n  status: 'pending_write',\n  planned_reply: `${product.product_name}: ${before} → ${after}`\n}}];\n"
      },
